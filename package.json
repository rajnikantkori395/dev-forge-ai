{
  "name": "dev-forge-ai",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "test:openrouter": "node scripts/test-openrouter.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:sideload:android": "eas build --platform android --profile sideload",
    "build:sideload:ios": "eas build --platform ios --profile sideload",
    "build:sideload": "eas build --platform all --profile sideload",
    "build:preview": "eas build --platform android --profile preview",
    "build:prod": "eas build --platform all --profile production",
    "submit:prod": "eas submit --platform all --profile production",
    "update:prod": "eas update --channel production --environment production",
    "update:preview": "eas update --channel preview --environment preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
