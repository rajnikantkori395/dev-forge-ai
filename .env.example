# Copy this file to `.env` in the project root (same folder as package.json).
# Expo loads `EXPO_PUBLIC_*` at build/start time — restart the dev server after changes.
#
# Native deps: use `npx expo install <pkg>` so versions match Expo Go (e.g. AsyncStorage 2.2.x for SDK 54).
#
# --- Required for real auth / database / Edge Function invoke ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
